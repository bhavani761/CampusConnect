<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lost & Found | CampusConnect</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6fb;
            color: #222;
        }

        header {
            background: #172554;
            color: white;
            padding: 22px;
            text-align: center;
        }

        nav {
            background: #1e3a8a;
            padding: 14px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
        }

        .container {
            max-width: 950px;
            margin: 35px auto;
            padding: 20px;
        }

        h2 {
            margin-bottom: 15px;
            color: #172554;
        }

        .form-box, .item-card {
            background: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        label {
            display: block;
            margin: 15px 0 7px;
            font-weight: bold;
        }

        input, textarea, select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        textarea {
            resize: vertical;
            min-height: 90px;
        }

        button {
            margin-top: 18px;
            padding: 12px 25px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            color: white;
            background: #dc2626;
            margin-bottom: 12px;
        }

        .badge.found {
            background: #16a34a;
        }

        .message {
            background: #dcfce7;
            color: #166534;
            padding: 12px;
            margin-bottom: 18px;
            border-radius: 6px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty {
            background: white;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
        }

        footer {
            text-align: center;
            padding: 20px;
            background: #172554;
            color: white;
        }
    </style>
</head>

<body>

<header>
    <h1>CampusConnect</h1>
    <p>Lost & Found Portal</p>
</header>

<nav>
    <a href="index.html">Home</a>
    <a href="dashboard">Dashboard</a>
    <a href="lost-found">Lost & Found</a>
</nav>

<div class="container">

    <h2>Report a Lost or Found Item</h2>

    
        
    

    <div class="form-box">

        <form method="POST" action="lost-found">

            <label>Report Type</label>
            <select name="report_type" required>
                <option value="Lost">Lost Item</option>
                <option value="Found">Found Item</option>
            </select>

            <label>Item Name</label>
            <input type="text" name="item_name"
                   placeholder="Enter item name" required>

            <label>Description</label>
            <textarea name="description"
                      placeholder="Describe the item" required></textarea>

            <label>Location</label>
            <input type="text" name="location"
                   placeholder="Where was it lost or found?" required>

            <button type="submit">Submit Report</button>

        </form>

    </div>

    <h2>Recent Lost & Found Reports</h2>

    

        

            <div class="item-card">

                <span class="badge found">
                    Found
                </span>

                <h3>Samsung Mobile Phone</h3>

                <p><strong>Description:</strong> A black Samsung mobile phone was found near the college canteen. The phone is in good condition.</p>

                <p><strong>Location:</strong> College Canteen</p>

            </div>

        

            <div class="item-card">

                <span class="badge ">
                    Lost
                </span>

                <h3>Black Wallet</h3>

                <p><strong>Description:</strong> A black leather wallet containing my college ID card and ATM card.</p>

                <p><strong>Location:</strong> College Library, Rajeev Institute of Technology</p>

            </div>

        

    

</div>

<footer>
    <p>© 2026 CampusConnect | Smart Student Hub</p>
</footer>

</body>
</html>